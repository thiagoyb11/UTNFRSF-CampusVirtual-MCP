# Copiá este archivo a .env para personalizar la ejecución local.
# La configuración también puede venir de variables de entorno.
UTN_CAMPUS_TIMEZONE=America/Argentina/Cordoba
UTN_CAMPUS_LOG_LEVEL=INFO
UTN_CAMPUS_BROWSER_TIMEOUT_SECONDS=30
UTN_CAMPUS_NAVIGATION_TIMEOUT_MS=10000

# Opcional: ruta a un binario compatible. Sin este valor se usa el incluido en el SDK.
# UTN_CAMPUS_LIGHTPANDA_BINARY=/ruta/a/lightpanda

# El login todavía no está implementado; esta base no solicita credenciales.
